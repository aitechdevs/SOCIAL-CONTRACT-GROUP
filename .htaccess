Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# Apply production canonical redirects only to the real domain; local development is unaffected.
RewriteCond %{HTTP_HOST} ^www\.socialcontractgroup\.org$ [NC]
RewriteRule ^ https://socialcontractgroup.org%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^socialcontractgroup\.org$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://socialcontractgroup.org%{REQUEST_URI} [R=301,L,NE]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:config|database|tests|tools|docs|releases)(?:/|$) - [F,L]
RewriteRule ^(?:bootstrap|data|seo)\.php$ - [F,L]
RewriteRule ^(?:README|DEPLOYMENT|SITEMAP|ASSET-GUIDE|SEO)\.md$ - [F,L]
</IfModule>
<FilesMatch "^(\.|.*\.(?:sql|log|ini|bak|env))">
Require all denied
</FilesMatch>

<FilesMatch "^(bootstrap|data|seo)\.php$">
Require all denied
</FilesMatch>
